{
  "name": "@itsoltech/jev-code-review",
  "version": "1.1.0",
  "description": "Configurable pull request review powered by TypeSafe Jev: GitHub Action and CLI",
  "keywords": [
    "code-review",
    "pull-request",
    "github-action",
    "typesafe",
    "jev",
    "cli"
  ],
  "homepage": "https://github.com/itsoltech/jev-code-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsoltech/jev-code-review.git"
  },
  "bugs": "https://github.com/itsoltech/jev-code-review/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jev-review": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen-schema": "node scripts/run-ts.mjs scripts/gen-schema.ts",
    "calibrate": "node --env-file-if-exists=.env scripts/run-ts.mjs scripts/calibrate.ts",
    "all": "npm run typecheck && npm test && npm run gen-schema && npm run build",
    "review-local": "node --env-file-if-exists=.env scripts/run-ts.mjs scripts/review-local.ts",
    "scan-patterns": "node scripts/run-ts.mjs scripts/scan-patterns.ts"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "esbuild": "^0.28.2",
    "p-limit": "^7.3.3",
    "picomatch": "^4.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
