{"id": "stale-folder-prop", "path": "web/Files.svelte", "patch": "@@ -0,0 +1,6 @@\n+let { folder } = $props()\n+let files = $state([])\n+async function load() {\n+  const result = await api.listFiles(folder)\n+  files = result\n+}", "labels": {"async.stale-write": {"violates": true}}}
{"id": "stale-guarded", "path": "web/Files.svelte", "patch": "@@ -0,0 +1,9 @@\n+let { folder } = $props()\n+let files = $state([])\n+let seq = 0\n+async function load() {\n+  const mine = ++seq\n+  const result = await api.listFiles(folder)\n+  if (mine !== seq) return\n+  files = result\n+}", "labels": {"async.stale-write": {"violates": false}}}
