        ],
        "severity": "minor",
        "locate": true,
        "min_confidence": 0.5,
        "guard": false,
        "candidate_removed": false,
        "type": "pattern",
        "field": "added_lines",
        "regex": "['\"`][^'\"`]*\\b(Cmd|Ctrl|⌘)\\s*\\+\\s*\\w",
        "flags": "",
        "ignore_regex": "isMac|isWindows|darwin|win32|linux|modKey|modifierLabel|accelerator|(Cmd|⌘)\\s*/\\s*Ctrl|Ctrl\\s*/\\s*(Cmd|⌘)",
        "fires_when": "match"
      },
      {
        "id": "electron.ipc-unvalidated-input",
        "description": "IPC handler uses a value from the renderer without validating it",
        "enabled": true,
        "scope": "hunk",
        "paths": [
          "src/main/**"
        ],
        "exclude_paths": [],
        "severity": "blocker",
        "instructions": "Does an added IPC handler (ipcMain.handle or ipcMain.on) in `changes.lines` pass a value that comes from the renderer (the handler's arguments or payload) into a file system call, a URL opener or network request, a shell, git or other command, a database query, or a size-dependent allocation, without validating that value first? Validation means checking its type, format, allowed values or size, or passing it through validatePathAccess(), validateCreationPath(), validateWorktreeScopedPathAccess(), validateFilePath() or an allowlist check.",
        "locate": true,
        "min_confidence": 0.5,
        "guard": false,
        "candidate_removed": false,
        "type": "noul",
        "criteria": {
          "true": "For example payload.repoRoot passed to a git command, a url passed to shell.openExternal, or payload.filePath passed to fs, with no check before it.",
          "false": "No IPC handler is added, the handler passes no renderer value to such a call, or every such value is checked or validated before it is used."
        },
        "fires_on": "yes",
        "threshold": 0.7
      },
      {
        "id": "svelte.effect-without-cleanup",
        "description": "$effect starts a listener, timer, subscription or observer without returning a cleanup",
        "enabled": true,
        "scope": "hunk",
        "paths": [
          "src/renderer/**/*.svelte",
          "src/renderer/**/*.svelte.ts"
        ],
        "exclude_paths": [],
        "severity": "major",
        "instructions": "Is there an added Svelte `$effect(() => { ... })` block in `changes.lines` whose body starts something that keeps running (addEventListener, setInterval, setTimeout, a subscribe or on* subscription, or a ResizeObserver, IntersectionObserver or MutationObserver), and whose body does not return a function that removes, clears, unsubscribes or disconnects it?",
        "locate": true,
        "min_confidence": 0.5,
        "guard": false,
        "candidate_removed": false,
        "type": "noul",
        "criteria": {
          "true": "Inside the $effect body a listener, timer, subscription or observer is created and the effect has no return statement that undoes it.",
          "false": "No $effect is added, the $effect only reads or assigns state, or it returns a cleanup: a function (return () => ...), a variable holding the unsubscribe function (return unsub), or the result of the subscribe call itself (return window.api.onSomething(...), which returns its unsubscribe function). Timers and listeners outside $effect do not count."
        },
        "fires_on": "yes",
        "threshold": 0.7
      },
      {
        "id": "svelte.legacy-export-let",
        "description": "Legacy `export let` prop; use $props() with an interface",
