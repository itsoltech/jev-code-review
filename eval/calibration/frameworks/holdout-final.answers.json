        "regex": "\\b(readFileSync|writeFileSync|appendFileSync|existsSync|statSync|lstatSync|readdirSync|mkdirSync|rmSync|unlinkSync|copyFileSync|renameSync|realpathSync|accessSync|mkdtempSync)\\(",
        "flags": "",
        "fires_when": "match"
      },
      {
        "id": "electron.shortcut-label-os",
        "description": "Keyboard shortcut label names only Cmd or only Ctrl instead of adapting to the OS",
        "enabled": true,
        "scope": "hunk",
        "paths": [
